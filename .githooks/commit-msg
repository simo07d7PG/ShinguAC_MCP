#!/bin/sh
title=$(head -n1 "$1")
types='Feat|Fix|Style|Refactor|Perf|Docs|Test|Build|CI|Chore|Revert'
printf '%s' "$title" | grep -Eq "^\[($types)\] [^ ].*[^.]$" \
  || { echo "✖ 제목 형식: [Type] 커밋 제목" >&2; exit 1; }
grep -Eiq 'claude|anthropic|generated with' "$1" \
  && { echo "✖ Claude/AI 표기 제거 필요" >&2; exit 1; }
exit 0
