{
  "name": "shingu-mcp",
  "version": "0.1.0",
  "description": "신구대학교 학생종합포털 MCP 서버",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shingu-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "recon": "tsx --env-file=.env scripts/recon.ts",
    "mask": "node scripts/mask-fixture.mjs",
    "check:pii": "node scripts/mask-fixture.mjs --check",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "recon:login": "tsx --env-file=.env scripts/recon-login.ts",
    "smoke:service": "tsx --env-file=.env scripts/smoke-service.ts",
    "smoke:stale": "tsx scripts/smoke-stale.ts",
    "smoke:submit-preview": "tsx --env-file=.env scripts/smoke-submit-preview.ts",
    "recon:submit": "tsx --env-file=.env scripts/recon-submit.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
